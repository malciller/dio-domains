{
  "theme": "tokyo-night",
  "alert_level": "warn",
  "logging_level": "info",
  "flow_log": {
    "enabled": false,
    "min_interval_seconds": 0.2,
    "heartbeat_seconds": 5.0,
    "pulse_seconds": 5.0,
    "price_ticks": true
  },
  "gc": {
    "minor_heap_size": 1048576,
    "space_overhead": 120,
    "max_overhead": 1000000,
    "window_size": 10,
    "allocation_policy": 2,
    "major_heap_increment": 1048576
  },
  "trading": {
    "defaults": {
      "strategy": {
        "hyperliquid": {
          "name": "jacobs_ladder",
          "sell_mult": "0.99",
          "sell_levels": false
        },
        "kraken": {
          "name": "jacobs_ladder",
          "sell_mult": "0.99",
          "accumulation_buffer": [0.1, 0.5],
          "sell_levels": false
        },
        "alpaca": {
          "name": "jacobs_ladder",
          "sell_mult": "0.999",
          "accumulation_buffer": [0.1, 0.5],
          "testnet": true,
          "sell_levels": true,
          "data_feed": "iex"
        }
      },
      // Overlays are optional and keyed by name. An asset's "overlay" list inherits
      // the matching block here. carry_overlay is the engine-integrated inventory
      // hedge; any other name is an additional generic overlay strategy.
      "overlay": {
        "carry_overlay": {
          "exchange": "hyperliquid",
          "params": {
            // true: full spot holdings (open-sell base included); false: accumulated basis.
            "full_balance_ref": false,
            "min_entry_margin_ratio": 1.0,
            "min_liq_mult": 1.0,
            "recycle_base_share_pct": 0
          }
        }
      },
      "oracle": {
        "target_survival": 0.95,
        "min_active_dsurv": 0.0,
        "qty_cap_mult": 1.5,
        // Trailing calendar-day window for the max-drawdown / high / low scan. 0 uses the
        // full all-time history. It must still contain the current cycle's high or the
        // measured drawdown is a fragment. Per-asset override on the asset group.
        "lookback_days": 730,
        "refresh_seconds": 300
      }
    },
    "assets": [
      {
        "asset": "BTC",
        "oracle": {
          "target_survival": 0.65,
          "qty_cap_mult": 3.0,
          // Per-asset window override; omit to inherit trading.defaults.oracle.
          // "lookback_days": 180
        },
        "strategy": {
          "exchange": "hyperliquid",
          "symbol": "BTC/USDC",
          "qty": "0.0001",
          "grid_interval": [0.1, 0.5],
          "cpu_priority": 10
        },
        "overlay": [
          {
            "name": "carry_overlay",
            "params": {
              "start_ratio_pct": 25,
              "add_threshold_pct": 10,
              "max_ratio_pct": 75,
              "short_tp_roe": 5,
              "recycle_base_share_pct": 50
            },
            "inventory": [
              { "exchange": "kraken", "symbol": "BTC/USD" }
            ]
          }
        ]
      },
      {
        "asset": "SPY",
        "oracle": {
          "target_survival": 0.7,
          "qty_cap_mult": 2.0
        },
        "strategy": {
          "exchange": "alpaca",
          "symbol": "SPY",
          "qty": "0.01",
          "grid_interval": [0.1, 0.5]
        }
      }
    ]
  },
  "strategy_trace": false
}
