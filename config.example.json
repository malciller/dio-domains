{
  "theme": "tokyo-night",
  "alert_level": "warn",
  "logging_level": "info",
  "flow_log": {
    "enabled": false,
    "min_interval_seconds": 0.2,
    "heartbeat_seconds": 5.0,
    "pulse_seconds": 5.0,
    "price_ticks": true
  },
  // Append-only record of every per-stage latency window, so a percentile regression is
  // visible after the fact instead of only in the live dashboard. On by default; it runs
  // on its own background domain and stops itself rather than risk the data directory
  // (which holds position state) running out of space. Query with:
  //   dio latency tail
  //   dio latency best
  //   dio latency compare <old> <new> --gate
  "latency_journal": {
    "enabled": true,
    // Clamped to at least 5s and to at least latency_window_seconds: a profiler
    // publishes only its newest window, so faster sampling would journal duplicates.
    "interval_s": 30,
    // Empty = <data dir>/latency (/app/data/latency in Docker, ./data/latency locally).
    "dir": "",
    "retain_days": 14,
    "max_total_mb": 128,
    // Stop journalling below this much free space on the data filesystem.
    "min_free_mb": 1024
  },
  "gc": {
    "minor_heap_size": 1048576,
    "space_overhead": 120,
    "max_overhead": 500,
    "window_size": 10,
    "allocation_policy": 2,
    "major_heap_increment": 1048576
  },
  "trading": {
    "defaults": {
      "strategy": {
        "hyperliquid": {
          "name": "jacobs_ladder",
          "sell_mult": "0.99",
          "sell_levels": false
        },
        "kraken": {
          "name": "jacobs_ladder",
          "sell_mult": "0.99",
          "accumulation_buffer": [0.1, 0.5],
          "sell_levels": false
        },
        "alpaca": {
          "name": "jacobs_ladder",
          "sell_mult": "0.99",
          "accumulation_buffer": [0.1, 0.5],
          "testnet": true,
          "sell_levels": true,
          "data_feed": "iex"
        }
      },
      "oracle": {
        "target_survival": 0.95,
        "min_active_dsurv": 0.0,
        "qty_cap_mult": 1.5,
        // Trailing calendar-day window for the max-drawdown / high / low scan. 0 uses the
        // full all-time history. It must still contain the current cycle's high or the
        // measured drawdown is a fragment. Per-asset override on the asset group.
        "lookback_days": 730,
        "refresh_seconds": 300
      }
    },
    "assets": [
      {
        "asset": "BTC",
        "oracle": {
          "target_survival": 0.65,
          "qty_cap_mult": 3.0,
          // Per-asset window override; omit to inherit trading.defaults.oracle.
          // "lookback_days": 180
        },
        "strategy": {
          "exchange": "hyperliquid",
          "symbol": "BTC/USDC",
          "qty": "0.0001",
          "grid_interval": [0.1, 0.5],
          "cpu_priority": 10
        }
      },
      {
        "asset": "SPY",
        "oracle": {
          "target_survival": 0.7,
          "qty_cap_mult": 2.0
        },
        "strategy": {
          "exchange": "alpaca",
          "symbol": "SPY",
          "qty": "0.01",
          "grid_interval": [0.1, 0.5]
        }
      }
    ]
  },
  "strategy_trace": false
}
