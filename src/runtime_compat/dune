(library
 (name runtime_compat)
 (public_name dio.runtime_compat)
 (modules runtime_compat)
 (libraries unix))

; OxCaml provides race-safe replacements under [Sys.Safe]/[Domain.Safe] and
; emits [unsafe_multidomain] alerts for the stdlib originals. The classic
; toolchain has neither the alerts nor the Safe modules, so we generate
; runtime_compat.ml from the matching source at build time.
; The classic-flambda toolchain reports [flambda = true]; OxCaml does not.
(rule
 (targets runtime_compat.ml)
 (enabled_if %{ocaml-config:flambda})
 (action (copy runtime_compat_stdlib.ml runtime_compat.ml)))

(rule
 (targets runtime_compat.ml)
 (enabled_if (not %{ocaml-config:flambda}))
 (action (copy runtime_compat_oxcaml.ml runtime_compat.ml)))
