(library
 (name ssl)
 (public_name dio.ssl)
 (libraries unix)
 (wrapped false)
 (foreign_stubs
  (language c)
  (names ssl_stubs)
  (flags
   (:standard -fPIC)
   (:include c_flags.sexp)))
 (c_library_flags
  (:include c_library_flags.sexp)))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (action
  (run ./config/discover.exe)))
