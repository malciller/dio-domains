(library
 (name ws_lwt)
 (public_name dio.ws_lwt)
 (modules ws_lwt ctx)
 (libraries
  websocket
  conduit-lwt-unix
  cohttp-lwt-unix
  lwt
  lwt.unix
  base64
  uri
  ipaddr.unix))

; Compatibility shim for [Conduit_lwt_unix.default_ctx], whose type changed from
; [ctx Lazy.t] (Conduit >= 3) to [ctx] (Conduit < 3, as bundled with the OxCaml
; toolchain). The discriminator is the compiler variant, not an environment
; variable: OxCaml identifies itself in [%{ocaml_version}] (e.g. "5.2.0+ox",
; the version pinned in Dockerfile.base) while classic OCaml reports a plain
; version (e.g. "5.2.0"). If the pinned OxCaml compiler version is bumped,
; update the string here to match.

(rule
 (targets ctx.ml)
 (enabled_if
  (= %{ocaml_version} "5.2.0+ox"))
 (action
  (copy ctx_direct.ml ctx.ml)))

(rule
 (targets ctx.ml)
 (enabled_if
  (<> %{ocaml_version} "5.2.0+ox"))
 (action
  (copy ctx_lazy.ml ctx.ml)))
