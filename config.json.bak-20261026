// ============================================================================
// dio engine config
//
// JSONC: // line comments, /* block comments */, and trailing commas are
// accepted. Comments are ignored by the engine.
//
// TRADING LAYOUT
// --------------
// Trading is grouped by ASSET. One asset = one overlay controller:
//
//   asset       logical group / perp coin (BTC, HYPE, BOTZ, ...)
//   strategy    optional primary strategy for this asset
//   overlay     optional overlay strategy. Declare its params ONCE here.
//               Every strategy and inventory leg in the group feeds this one
//               overlay and therefore one perp position.
//   inventory   extra balance-only legs (they run no primary strategy)
//   oracle      sizing overrides for this asset's primary strategy
//
// The section names describe the role, not a specific authored strategy. The
// strategy file is named by "name" inside the section.
//
// Defaults are shallow-merged: objects merge key-by-key; scalars and arrays
// replace. Venue defaults live in trading.defaults.strategy.<exchange>.
// ============================================================================
{
  // --------------------------------------------------------------------------
  // UI / logging
  // --------------------------------------------------------------------------
  "theme": "gruvbox",
  "alert_level": "error",
  "logging_level": "info",
  "logging_sections": "",
  "logging_width": 175,
  // Decision-flow telemetry (off by default)
  "flow_log": {
    "enabled": false,
    "min_interval_seconds": 0.2,
    "heartbeat_seconds": 5.0,
    "pulse_seconds": 5.0,
    "price_ticks": false
  },
  // --------------------------------------------------------------------------
  // Engine timing / latency reporting
  // --------------------------------------------------------------------------
  "cycle_mod": 10000,
  "fng_check_threshold": 2.5,
  "latency_spike_threshold_us": 200,
  "latency_spike_report": "internal",
  "latency_spike_report_seconds": 5,
  "latency_network_spike_threshold_us": 20000,
  // --------------------------------------------------------------------------
  // GC tuning
  // --------------------------------------------------------------------------
  "gc": {
    // 8 MB minor heap (was 1 MB). At 1 MB a domain collected a minor heap every
    // ~1 MB of allocation, and the resulting promotion bursts drove the major
    // collector hard: 6 stop-the-world slices/s, median 718us, p90 1.3ms, all
    // measurable as simultaneous sub-ms stalls across every domain.
    "minor_heap_size": 1048576,
    // Keep the major heap closer to live data (was 200 = 3x live). Less free space
    // means less sweep work per slice and slower heap growth; the trade is slightly
    // more frequent major slices.
    "space_overhead": 120,
    "max_overhead": 1000000,
    "window_size": 10,
    "allocation_policy": 2,
    "major_heap_increment": 1048576
  },
  // --------------------------------------------------------------------------
  // Trading
  // --------------------------------------------------------------------------
  "trading": {
    // Shared defaults. Each strategy inherits its venue's block; each
    // overlay inherits the overlay block. Override only what differs.
    "defaults": {
      "strategy": {
        "hyperliquid": {
          "name": "jacobs_ladder",
          "sell_mult": "0.98",
          "sell_levels": false
        },
        "kraken": {
          "name": "jacobs_ladder",
          "sell_mult": "0.99",
          "accumulation_buffer": [0.1, 1.5],
          "sell_levels": false
        }
      },
      "overlay": {
        "name": "carry_overlay",
        "exchange": "hyperliquid",
        "full_balance_ref": true, // false: accumulated basis (open-sell base excluded)
        "min_entry_margin_ratio": 1.0,
        "min_liq_mult": 1.0,
        "add_threshold_pct": 2.5,
        "recycle_base_share_pct": 50
      },
      "oracle": {
        "target_survival": 0.95,
        "min_active_dsurv": 0.0,
        "qty_cap_mult": 1.5,
        "refresh_seconds": 300
      }
    },
    "assets": [
      // ======================================================================
      // BTC — Hyperliquid strategy, hedged on the HL BTC perp.
      // Kraken BTC balance is an inventory leg of the same overlay.
      // ======================================================================
      {
        "asset": "BTC",
        "oracle": {
          "target_survival": 0.65,
          "qty_cap_mult": 3.0
        },
        "strategy": {
          "exchange": "hyperliquid",
          "symbol": "BTC/USDC",
          "qty": "0.0003",
          "grid_interval": [0.15, 0.20],
          "accumulation_buffer": [0.04, 0.35],
          "cpu_priority": 10
        },
        "overlay": {
          "leverage": 20,
          "start_ratio_pct": 5,
          "max_ratio_pct": 75,
          "recycle_profit_pct": 2.4,
          "inventory": [
            { "exchange": "kraken", "symbol": "BTC/USD" }
          ]
        }
      },
      // ======================================================================
      // HYPE — Hyperliquid strategy, hedged on the HL HYPE perp.
      // ======================================================================
      {
        "asset": "HYPE",
        "oracle": {
          "target_survival": 0.5,
          "qty_cap_mult": 3.0
        },
        "strategy": {
          "exchange": "hyperliquid",
          "symbol": "HYPE/USDC",
          "qty": "0.15",
          "grid_interval": [0.18, 0.25],
          "accumulation_buffer": [0.1, 0.4],
          "cpu_priority": 10
        },
        "overlay": {
          "leverage": 10,
          "start_ratio_pct": 5,
          "max_ratio_pct": 75,
          "recycle_profit_pct": 1.6,
          "add_threshold_pct": 1.0
        }
      },
      // ======================================================================
      // XMR — Kraken strategy, hedged on the HL XMR perp. No HL spot leg:
      // recycle is 100% quote. Start 31%, add ladder may reach 100%.
      // ======================================================================
      {
        "asset": "XMR",
        "strategy": {
          "exchange": "kraken",
          "symbol": "XMR/USD",
          "qty": "0.02",
          "grid_interval": [1.6, 2.5],
          "accumulation_buffer": [0.1, 0.8]
        },
        "overlay": {
          "leverage": 5,
          "start_ratio_pct": 31,
          "max_ratio_pct": 100,
          "recycle_profit_pct": 5,
          "add_threshold_pct": 1.0
        }
      },
      // ======================================================================
      // ETH — Kraken strategy, hedged on the HL ETH perp. The HL ETH/USDC spot
      // balance is an inventory leg of the same overlay.
      // ======================================================================
      {
        "asset": "ETH",
        "strategy": {
          "exchange": "kraken",
          "symbol": "ETH/USD",
          "qty": "0.0045",
          "grid_interval": [2.5, 10.0]
        },
        "overlay": {
          "leverage": 20,
          "start_ratio_pct": 5,
          "max_ratio_pct": 75,
          "recycle_profit_pct": 2.4,
          "inventory": [
            { "exchange": "hyperliquid", "symbol": "ETH/USDC" }
          ]
        }
      },
      // ======================================================================
      // SOL — Kraken strategy, hedged on the HL SOL perp. The HL SOL/USDC spot
      // balance is an inventory leg of the same overlay.
      // ======================================================================
      {
        "asset": "SOL",
        "strategy": {
          "exchange": "kraken",
          "symbol": "SOL/USD",
          "qty": "0.11",
          "grid_interval": [2.5, 10.0]
        },
        "overlay": {
          "leverage": 20,
          "start_ratio_pct": 5,
          "max_ratio_pct": 75,
          "recycle_profit_pct": 2.8,
          "inventory": [
            { "exchange": "hyperliquid", "symbol": "SOL/USDC" }
          ]
        }
      },
      // ======================================================================
      // ADA — Kraken strategy, hedged on the HL ADA perp. No HL spot leg:
      // recycle is 100% quote.
      // ======================================================================
      {
        "asset": "ADA",
        "strategy": {
          "exchange": "kraken",
          "symbol": "ADA/USD",
          "qty": "50.0",
          "grid_interval": [5.0, 10.0],
          "accumulation_buffer": [0.1, 2.0]
        },
        "overlay": {
          "leverage": 10,
          "start_ratio_pct": 5,
          "max_ratio_pct": 75,
          "recycle_profit_pct": 2.0,
          "add_threshold_pct": 1.0,
        }
      }
    ]
  },
  "strategy_trace": false
}
