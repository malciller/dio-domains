-- dip_scalper.strategy — passive dip-buy / bounce-sell scalper.
--
-- One lot at a time: rest a post-only buy a fixed percentage below the
-- reference price, then on the buy fill rest a take-profit sell above the
-- fill and book the quantity into the reserve ledger. Entries stand down when
-- the capital oracle is halted or a buy is already working. Reads top to
-- bottom; each indented block under a label is one step.
strategy dip_scalper
version 1

remembers:
  cycle.ok: bool
  entry.ok: bool
  last.fill: float?
  last.balance: float?

tunable:
  qty: decimal_str = "0.00025"
  entry.dip.pct: float = 0.4
  exit.rip.pct: float = 0.6

-- Fills own the sell leg: a buy fill immediately rests a take-profit sell and
-- a sell fill closes the round trip. Each branch stops the cycle, so the
-- order-lifecycle catch-all below never double-processes a fill.
when order.fills:

  buy.filled:
    let exit.price = $event.price * (1.0 + $params.exit.rip.pct / 100.0)
    if $event.side == "buy":
      place.sell(qty: $event.qty, price: exit.price,
                 dedup_key: "dip_scalper:exit")
      accumulate(qty: $event.qty)
      last.fill = $event.price
      stop

  sell.filled:
    if $event.side == "sell":
      notify.oracle(message: "dip_scalper: round trip complete")
      stop

-- Order lifecycle that is not a fill routes to the engine's reference handler.
when any.order.event:

  lifecycle:
    apply.order.event
    stop

when book.updates:

  prepare:
    init.venue.state
    resolve.book
    early.facts
    cycle.ok = not $platform.price.nan and
               not ($platform.check.stale.balance and
                    ($platform.asset.balance.nan or $platform.quote.balance.nan))

  skip.nan.price:
    if $platform.price.nan:
      stop

  cleanup:
    expire.amend.cooldowns
    evict.ghost.orders

  sync:
    scan.open.orders

  fee:
    if not $platform.maker.fee.set or $platform.fee.refresh.due:
      refresh.maker.fee

  gate:
    if cycle.ok:
      cycle.facts
      buy.gate
      entry.ok = not $platform.oracle.halted and
                 not $platform.has.pending.buy and
                 not $platform.has.tracked.buy

  enter:
    let entry.price = $price * (1.0 - $params.entry.dip.pct / 100.0)
    if cycle.ok and entry.ok and
       not $platform.buy.capital.low and not $platform.buy.crossing and
       not $platform.buy.quote.nan and $platform.buy.balance.ok:
      place.buy(qty: $params.qty.dec, price: entry.price,
                post_only: true, dedup_key: "dip_scalper:entry")
      track.buy(token: "entry", price: entry.price)

when balance.updates:

  note.balance:
    last.balance = $event.available
    stop
