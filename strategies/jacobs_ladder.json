{
  "name": "jacobs_ladder",
  "version": 1,
  "triggers": ["book_update", "fill", "order_lifecycle"],
  "params": {},
  "state": {},
  "steps": [
    {
      "id": "ev_filled",
      "when": { "event": "filled" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "ev_cancelled",
      "when": { "event": "cancelled" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "ev_acknowledged",
      "when": { "event": "acknowledged" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "ev_amended",
      "when": { "event": "amended" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "ev_failed",
      "when": { "event": "failed" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "ev_rejected",
      "when": { "event": "rejected" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "ev_amendment_skipped",
      "when": { "event": "amendment_skipped" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "ev_amendment_failed",
      "when": { "event": "amendment_failed" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "ev_cancel_cleanup",
      "when": { "event": "cancel_cleanup" },
      "then": [{ "action": "on_event", "args": {} }],
      "stop": true
    },
    {
      "id": "prepare",
      "when": { "event": "book_update" },
      "then": [{ "action": "cycle_prepare", "args": {} }]
    },
    {
      "id": "skip_nan_price",
      "when": { "event": "book_update", "engine": { "continue": false } },
      "then": [],
      "stop": true
    },
    {
      "id": "cleanup",
      "when": { "event": "book_update" },
      "then": [{ "action": "cycle_cleanup", "args": {} }]
    },
    {
      "id": "sync",
      "when": { "event": "book_update" },
      "then": [{ "action": "cycle_sync", "args": {} }]
    },
    {
      "id": "fee",
      "when": { "event": "book_update" },
      "then": [{ "action": "cycle_refresh_fee", "args": {} }]
    },
    {
      "id": "stale_guard",
      "when": { "event": "book_update" },
      "then": [{ "action": "cycle_guard", "args": {} }]
    },
    {
      "id": "buy_gate",
      "when": { "event": "book_update", "engine": { "continue": true } },
      "then": [{ "action": "buy_gate", "args": {} }]
    },
    {
      "id": "buy_facts",
      "when": {
        "all": [
          { "event": "book_update" },
          { "engine": { "buy_active": true } }
        ]
      },
      "then": [{ "action": "buy_facts", "args": {} }]
    },
    {
      "id": "buy_cancel",
      "when": {
        "all": [
          { "event": "book_update" },
          { "engine": { "buy_active": true } },
          { "not": { "engine": { "buy_pending": true } } },
          { "engine": { "buy_should_cancel": true } }
        ]
      },
      "then": [{ "action": "buy_cancel", "args": {} }]
    },
    {
      "id": "buy_place",
      "when": {
        "all": [
          { "event": "book_update" },
          { "engine": { "buy_active": true } },
          { "not": { "engine": { "buy_pending": true } } },
          { "not": { "engine": { "buy_should_cancel": true } } },
          { "engine": { "buy_count_zero": true } }
        ]
      },
      "then": [{ "action": "buy_place", "args": {} }]
    },
    {
      "id": "buy_amend",
      "when": {
        "all": [
          { "event": "book_update" },
          { "engine": { "buy_active": true } },
          { "not": { "engine": { "buy_pending": true } } },
          { "not": { "engine": { "buy_should_cancel": true } } },
          { "engine": { "buy_count_positive": true } }
        ]
      },
      "then": [{ "action": "buy_amend", "args": {} }]
    },
    {
      "id": "sell",
      "when": { "event": "book_update", "engine": { "continue": true } },
      "then": [
        { "action": "sell_prepare", "args": {} },
        { "action": "sell_place", "args": {} },
        { "action": "sell_finalize", "args": {} }
      ],
      "stop": true
    }
  ]
}
