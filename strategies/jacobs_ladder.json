{
  "name": "jacobs_ladder",
  "version": 1,
  "triggers": ["book_update"],
  "params": {},
  "state": {},
  "steps": [
    {
      "id": "prepare",
      "when": { "event": "book_update" },
      "then": [{ "action": "grid_prepare", "args": {} }]
    },
    {
      "id": "skip_nan_price",
      "when": { "engine": { "continue": false } },
      "then": [],
      "stop": true
    },
    {
      "id": "cleanup",
      "then": [{ "action": "grid_cleanup", "args": {} }]
    },
    {
      "id": "sync",
      "then": [{ "action": "grid_sync", "args": {} }]
    },
    {
      "id": "fee",
      "then": [{ "action": "grid_refresh_fee", "args": {} }]
    },
    {
      "id": "stale_guard",
      "then": [{ "action": "grid_guard", "args": {} }]
    },
    {
      "id": "buy_gate",
      "when": { "engine": { "continue": true } },
      "then": [{ "action": "grid_buy_gate", "args": {} }]
    },
    {
      "id": "buy_facts",
      "when": { "all": [ { "engine": { "buy_active": true } } ] },
      "then": [{ "action": "grid_buy_facts", "args": {} }]
    },
    {
      "id": "buy_pending",
      "when": { "all": [ { "engine": { "buy_active": true } }, { "engine": { "buy_pending": true } } ] },
      "then": [],
      "stop": true
    },
    {
      "id": "buy_cancel",
      "when": { "all": [ { "engine": { "buy_active": true } }, { "engine": { "buy_should_cancel": true } } ] },
      "then": [{ "action": "grid_buy_cancel", "args": {} }],
      "stop": true
    },
    {
      "id": "buy_place",
      "when": { "all": [ { "engine": { "buy_active": true } }, { "engine": { "buy_count_zero": true } } ] },
      "then": [{ "action": "grid_buy_place", "args": {} }],
      "stop": true
    },
    {
      "id": "buy_amend",
      "when": { "all": [ { "engine": { "buy_active": true } }, { "engine": { "buy_count_positive": true } } ] },
      "then": [{ "action": "grid_buy_amend", "args": {} }],
      "stop": true
    },
    {
      "id": "sell",
      "when": { "engine": { "continue": true } },
      "then": [
        { "action": "grid_sell_prepare", "args": {} },
        { "action": "grid_sell_place", "args": {} },
        { "action": "grid_sell_finalize", "args": {} }
      ],
      "stop": true
    }
  ]
}
