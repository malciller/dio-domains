{
  "name": "jacobs_ladder",
  "version": 1,
  "triggers": [
    "book_update",
    "fill",
    "order_lifecycle"
  ],
  "params": {},
  "state": {
    "cycle_ok": {
      "type": "bool"
    },
    "buy_active": {
      "type": "bool"
    },
    "buy_pending": {
      "type": "bool"
    },
    "buy_should_cancel": {
      "type": "bool"
    },
    "buy_count_zero": {
      "type": "bool"
    },
    "buy_count_positive": {
      "type": "bool"
    }
  },
  "steps": [
    {
      "id": "ev_filled",
      "when": {
        "event": "filled"
      },
      "then": [
        {
          "action": "apply_order_event",
          "args": {}
        }
      ],
      "stop": true
    },
    {
      "id": "prepare",
      "when": {
        "event": "book_update"
      },
      "then": [
        {
          "action": "init_venue_state",
          "args": {}
        },
        {
          "action": "prepare_recovery",
          "args": {}
        },
        {
          "action": "resolve_book",
          "args": {}
        },
        {
          "action": "early_facts",
          "args": {}
        },
        {
          "action": "set_gate",
          "args": {
            "name": "cycle_ok",
            "value": "not $platform.price_nan and not ($platform.check_stale_balance and ($platform.asset_balance_nan or $platform.quote_balance_nan))"
          }
        }
      ]
    },
    {
      "id": "skip_nan_price",
      "when": {
        "event": "book_update",
        "expr": "$platform.price_nan"
      },
      "then": [],
      "stop": true
    },
    {
      "id": "cleanup",
      "when": {
        "event": "book_update"
      },
      "then": [
        {
          "action": "expire_amend_cooldowns",
          "args": {}
        },
        {
          "action": "evict_ghost_orders",
          "args": {}
        }
      ]
    },
    {
      "id": "sync",
      "when": {
        "event": "book_update"
      },
      "then": [
        {
          "action": "scan_open_orders",
          "args": {}
        }
      ]
    },
    {
      "id": "fee",
      "when": {
        "event": "book_update",
        "expr": "not $platform.maker_fee_set or $platform.fee_refresh_due"
      },
      "then": [
        {
          "action": "refresh_maker_fee",
          "args": {}
        }
      ]
    },
    {
      "id": "mark_stale",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "not $platform.price_nan and $platform.check_stale_balance and ($platform.asset_balance_nan or $platform.quote_balance_nan)"
          }
        ]
      },
      "then": [
        {
          "action": "mark_stale_cycle",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_gate",
      "when": {
        "event": "book_update",
        "expr": "$state.cycle_ok"
      },
      "then": [
        {
          "action": "expire_tif_recovery",
          "args": {}
        },
        {
          "action": "cycle_facts",
          "args": {}
        },
        {
          "action": "set_gate",
          "args": {
            "name": "buy_active",
            "value": "not ($platform.oracle_halted and not ($platform.tif_recovery_pending and $now - $platform.tif_recovery_since < 900))"
          }
        },
        {
          "action": "set_gate",
          "args": {
            "name": "buy_pending",
            "value": "not $platform.has_pending_buy"
          }
        },
        {
          "action": "set_gate",
          "args": {
            "name": "buy_should_cancel",
            "value": "$platform.open_buy_count > 1 and not $platform.inflight_cancel_buy and not $platform.inflight_amend_buy and not $platform.has_recent_amend_buy"
          }
        },
        {
          "action": "set_gate",
          "args": {
            "name": "buy_count_zero",
            "value": "not ($platform.open_buy_count > 0 or $platform.has_tracked_buy)"
          }
        },
        {
          "action": "set_gate",
          "args": {
            "name": "buy_count_positive",
            "value": "$platform.open_buy_count > 0 or $platform.has_tracked_buy"
          }
        }
      ]
    },
    {
      "id": "buy_cancel",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "$state.buy_should_cancel"
          }
        ]
      },
      "then": [
        {
          "action": "cancel_excess_buys",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_place_plan",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "not $state.buy_should_cancel"
          },
          {
            "expr": "$state.buy_count_zero"
          }
        ]
      },
      "then": [
        {
          "action": "buy_place_plan",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_place_send",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "not $state.buy_should_cancel"
          },
          {
            "expr": "$state.buy_count_zero"
          },
          {
            "expr": "not $platform.buy_capital_low"
          },
          {
            "expr": "not $platform.buy_crossing"
          },
          {
            "expr": "not $platform.buy_quote_nan"
          },
          {
            "expr": "not $platform.buy_cooldown"
          },
          {
            "expr": "not $platform.buy_inflight"
          },
          {
            "expr": "$platform.buy_balance_ok"
          }
        ]
      },
      "then": [
        {
          "action": "buy_place_send",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_place_send_insufficient",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "not $state.buy_should_cancel"
          },
          {
            "expr": "$state.buy_count_zero"
          },
          {
            "expr": "not $platform.buy_capital_low"
          },
          {
            "expr": "not $platform.buy_crossing"
          },
          {
            "expr": "not $platform.buy_quote_nan"
          },
          {
            "expr": "not $platform.buy_cooldown"
          },
          {
            "expr": "not $platform.buy_inflight"
          },
          {
            "expr": "not $platform.buy_balance_ok"
          },
          {
            "expr": "$platform.quote_balance_stale"
          }
        ]
      },
      "then": [
        {
          "action": "buy_place_send_insufficient",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_place_latch",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "not $state.buy_should_cancel"
          },
          {
            "expr": "$state.buy_count_zero"
          },
          {
            "expr": "not $platform.buy_capital_low"
          },
          {
            "expr": "not $platform.buy_crossing"
          },
          {
            "expr": "not $platform.buy_quote_nan"
          },
          {
            "expr": "not $platform.buy_cooldown"
          },
          {
            "expr": "not $platform.buy_inflight"
          },
          {
            "expr": "not $platform.buy_balance_ok"
          },
          {
            "expr": "not $platform.quote_balance_stale"
          }
        ]
      },
      "then": [
        {
          "action": "buy_place_latch_capital_low",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_place_warn",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "not $state.buy_should_cancel"
          },
          {
            "expr": "$state.buy_count_zero"
          },
          {
            "expr": "not $platform.buy_capital_low"
          },
          {
            "expr": "not $platform.buy_crossing"
          },
          {
            "expr": "$platform.buy_quote_nan"
          }
        ]
      },
      "then": [
        {
          "action": "buy_place_warn_quote",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_amend_has_sell",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "not $state.buy_should_cancel"
          },
          {
            "expr": "$state.buy_count_positive"
          }
        ]
      },
      "then": [
        {
          "action": "buy_amend_has_sell",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_amend_with_sell",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "not $state.buy_should_cancel"
          },
          {
            "expr": "$state.buy_count_positive"
          },
          {
            "expr": "$platform.amend_has_sell"
          }
        ]
      },
      "then": [
        {
          "action": "buy_amend_with_sell",
          "args": {}
        }
      ]
    },
    {
      "id": "buy_amend_no_sell",
      "when": {
        "all": [
          {
            "event": "book_update"
          },
          {
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$state.buy_active"
          },
          {
            "expr": "$state.buy_pending"
          },
          {
            "expr": "not $state.buy_should_cancel"
          },
          {
            "expr": "$state.buy_count_positive"
          },
          {
            "expr": "not $platform.amend_has_sell"
          }
        ]
      },
      "then": [
        {
          "action": "buy_amend_no_sell",
          "args": {}
        }
      ]
    },
    {
      "id": "sell_prepare",
      "when": {
        "event": "book_update",
        "expr": "$state.cycle_ok"
      },
      "then": [
        {
          "action": "plan_sell_order",
          "args": {}
        }
      ]
    },
    {
      "id": "sell_place_should",
      "when": {
        "event": "book_update",
        "expr": "$state.cycle_ok"
      },
      "then": [
        {
          "action": "sell_place_should",
          "args": {}
        }
      ]
    },
    {
      "id": "sell_place",
      "when": {
        "all": [
          {
            "event": "book_update",
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$platform.sell_place_should"
          }
        ]
      },
      "then": [
        {
          "action": "sell_place_body",
          "args": {}
        }
      ]
    },
    {
      "id": "sell_finalize_latch",
      "when": {
        "event": "book_update",
        "expr": "$state.cycle_ok"
      },
      "then": [
        {
          "action": "sell_finalize_latch",
          "args": {}
        },
        {
          "action": "sell_finalize_facts",
          "args": {}
        }
      ]
    },
    {
      "id": "sell_excess_sweep",
      "when": {
        "event": "book_update",
        "all": [
          {
            "event": "book_update",
            "expr": "$state.cycle_ok"
          },
          {
            "expr": "$platform.remaintain_expired_sells and $platform.sell_missing_empty and not $platform.just_filled_buy and not $platform.resuming_after_balance and not $platform.buy_attempted and not $platform.sell_pushed and not $platform.has_active_sell and not $platform.asset_balance_nan and $platform.balance_fresh"
          }
        ]
      },
      "then": [
        {
          "action": "sell_excess_sweep_phase",
          "args": {}
        }
      ]
    },
    {
      "id": "sell_finalize_end",
      "when": {
        "event": "book_update",
        "expr": "$state.cycle_ok"
      },
      "then": [
        {
          "action": "sell_finalize_end",
          "args": {}
        }
      ],
      "stop": true
    }
  ]
}
