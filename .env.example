# dio environment file.
# Copy to .env and fill in the venues you actually trade. Every variable is
# optional; the engine starts without it and the corresponding adapter simply
# has no credentials. See https://diophantsolutions.com/dio/CONFIGURATION/ for
# the full reference.

# --- Kraken (spot) -----------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Hyperliquid (spot + perpetual) -----------------------------------------
# Account address used for balance and fee queries.
HYPERLIQUID_WALLET_ADDRESS=
# Private key for the EIP-712 order signer. Treat as a hot wallet key.
HYPERLIQUID_PRIVATE_KEY=

# --- Interactive Brokers (via IB Gateway over TCP) ---------------------------
IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4002
IBKR_TRADING_MODE=paper
IBKR_CLIENT_ID=0
# Optional; auto-detected when unset.
IBKR_ACCOUNT_ID=

# --- Alpaca (US equities) ----------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Lighter (perpetual DEX) -------------------------------------------------
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_KEY_INDEX=
LIGHTER_ACCOUNT_INDEX=
# Path to the signer shared library inside the container (linux/amd64).
LIGHTER_SIGNER_LIB_PATH=./lighter-signer-linux-amd64
# Comma-separated pool of relay proxy URLs.
LIGHTER_PROXY_URL=

# --- Fear & Greed (CoinMarketCap) -------------------------------------------
# Missing key falls back to a neutral value.
CMC_API_KEY=

# --- Discord fill notifications ---------------------------------------------
# Unset disables the notifier.
DISCORD_WEBHOOK_URL=

# --- Engine / runtime (all optional) -----------------------------------------
# Pretty-print OCaml backtraces on crash.
# DIO_BACKTRACE=
# State directory override (defaults to data/, or /app/data in Docker).
# DIO_DATA_DIR=
# Disable the main-loop watchdog.
# DIO_WATCHDOG_OFF=
# Disable the stop-the-world canary domain (it busy-spins one core).
# DIO_CANARY=0
# DIO_CANARY_THRESHOLD_US=10
# DIO_CANARY_WINDOW_S=5
# Log width when stdout is not a TTY.
# COLUMNS=200

# --- Dashboard rendering (all optional) --------------------------------------
# DIO_MOTION=off
# DIO_FPS=30.0
# DIO_DAMAGE=off
