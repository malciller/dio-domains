# dio environment file.
# Copy to .env and fill in the venues you actually trade. Every variable is
# optional; the engine starts without it and the corresponding adapter simply
# has no credentials. See https://diophantsolutions.com/dio/CONFIGURATION/ for
# the full reference.

# --- Kraken (spot) -----------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Hyperliquid (spot + perpetual) -----------------------------------------
# Account address used for balance and fee queries.
HYPERLIQUID_WALLET_ADDRESS=
# Private key for the EIP-712 order signer. Treat as a hot wallet key.
HYPERLIQUID_PRIVATE_KEY=

# --- Interactive Brokers (via IB Gateway over TCP) ---------------------------
IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4002
IBKR_TRADING_MODE=paper
IBKR_CLIENT_ID=0
# Optional; auto-detected when unset.
IBKR_ACCOUNT_ID=

# --- Alpaca (US equities) ----------------------------------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Lighter (perpetual DEX) -------------------------------------------------
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_KEY_INDEX=
LIGHTER_ACCOUNT_INDEX=
# Path to the signer shared library inside the container (linux/amd64).
LIGHTER_SIGNER_LIB_PATH=./native/lighter-signer-linux-amd64

# --- Fear & Greed (CoinMarketCap) -------------------------------------------
# Missing key falls back to a neutral value.
CMC_API_KEY=

# --- Discord fill notifications ---------------------------------------------
# Unset disables the notifier.
DISCORD_WEBHOOK_URL=

# --- Engine / runtime (all optional) -----------------------------------------
# Pretty-print OCaml backtraces on crash.
# DIO_BACKTRACE=
# State directory override (defaults to data/, or /app/data in Docker).
# DIO_DATA_DIR=
# Disable the main-loop watchdog.
# DIO_WATCHDOG_OFF=
# Disable the stop-the-world canary domain (it busy-spins one core).
# DIO_CANARY=0
# DIO_CANARY_THRESHOLD_US=10
# DIO_CANARY_WINDOW_S=5
# Log width when stdout is not a TTY.
# COLUMNS=200

# --- Latency / CPU placement (all optional) ----------------------------------
# Comma-separated CPUs for the per-asset trading domains. Unset auto-detects
# the P-cores from topology and max frequency.
# DIO_TRADING_CPUS=0,2,4,6,8,10
# SCHED_FIFO priority for a pinned trading domain (needs CAP_SYS_NICE).
# DIO_TRADING_RT_PRIO=
# Comma-separated CPUs for background work (E-cores). Defaults to every CPU
# that is not a trading CPU.
# DIO_BACKGROUND_CPUS=
# Comma-separated P-cores for the per-venue parse domains. Unset leaves the
# scheduler in charge.
# DIO_PARSE_CPUS=
# Use the x86_64 invariant TSC for the latency clock instead of
# clock_gettime(CLOCK_MONOTONIC). Opt-in: TSC is not guaranteed to share an
# offset across cores/packages (hybrid P/E parts especially), and a migrated
# thread then reports a phantom tail spike. Leave unset unless every trading
# domain is pinned and you have verified TSC sync across those cores.
# DIO_CLOCK=tsc
# Keep each trading domain spinning instead of parking. Only enable with one
# isolated core per trading domain (isolcpus/nohz_full) and parse shards pinned
# elsewhere; otherwise the spin starves unpinned feed threads and inflates tails.
# DIO_BUSY_SPIN=1

# --- Dashboard rendering (all optional) --------------------------------------
# DIO_MOTION=off
# DIO_FPS=30.0
# DIO_DAMAGE=off
